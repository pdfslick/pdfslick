{
  "compilerOptions": {
    "jsxImportSource": "@solidjs/web",
    "outDir": "dist",
    "target": "es6",
    "moduleResolution": "bundler",
    "noEmit": false,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "jsx": "preserve"
  },
  "extends": "tsconfig/core.json",
  "include": ["."],
  "exclude": ["dist", "build", "node_modules"]
}
